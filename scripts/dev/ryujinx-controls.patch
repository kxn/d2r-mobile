index 00000000..0b2702ec
--- /dev/null
+++ b/src/Ryujinx.HLE/Debugger/Debugger.Control.cs
@@ -0,0 +1,106 @@
+using Ryujinx.Graphics.GAL;
+using Ryujinx.Graphics.GAL.Multithreading;
+using System;
+using System.Globalization;
+using System.IO;
+using System.Text.Json;
+
+namespace Ryujinx.HLE.Debugger
+{
+    public partial class Debugger
+    {
+        private readonly object _captureLock = new();
+        private EventHandler<ScreenCaptureImageInfo> _captureHandler;
+        private object _captureStatus = new { status = "idle" };
+
+        private void CancelD2rCapture()
+        {
+            lock (_captureLock)
+            {
+                if (_captureHandler != null)
+                    Device.Gpu.Renderer.ScreenCaptured -= _captureHandler;
+                _captureHandler = null;
+                _captureStatus = new { status = "idle" };
+            }
+        }
+
+        private string D2rControl(string arguments)
+        {
+            try
+            {
+                string[] args = arguments.Split(' ', StringSplitOptions.RemoveEmptyEntries);
+                if (args.Length == 0) throw new ArgumentException("Missing command");
+                object result;
+                switch (args[0])
+                {
+                    case "info" when args.Length == 1:
+                        result = new { protocol = 1, input = "player1-procontroller", screenshot = "next-presented-frame-rgba", deterministicClock = false };
+                        break;
+                    case "input" when args.Length == 6:
+                        ulong buttons = ulong.Parse(args[1].Replace("0x", ""), NumberStyles.HexNumber, CultureInfo.InvariantCulture);
+                        int Axis(int i) => int.Parse(args[i], CultureInfo.InvariantCulture);
+                        result = new { generation = Device.Hid.Npads.SetScriptInput(buttons, Axis(2), Axis(3), Axis(4), Axis(5)) };
+                        break;
+                    case "input-state" when args.Length == 1:
+                        result = Device.Hid.Npads.GetScriptInputStatus();
+                        break;
+                    case "release" when args.Length == 1:
+                        Device.Hid.Npads.ClearScriptInput();
+                        result = new { released = true };
+                        break;
+                    case "shot-cancel" when args.Length == 1:
+                        CancelD2rCapture();
+                        result = new { status = "idle" };
+                        break;
+                    case "shot-status" when args.Length == 1:
+                        lock (_captureLock) { result = _captureStatus; }
+                        break;
+                    case "screenshot" when args.Length == 1:
+                        lock (_captureLock)
+                        {
+                            IRenderer renderer = Device.Gpu.Renderer;
+                            if (renderer is ThreadedRenderer threaded) renderer = threaded.BaseRenderer;
+                            if (renderer.Window == null)
+                            {
+                                result = new { status = "not-ready" };
+                                break;
+                            }
+                            if (_captureHandler != null) throw new InvalidOperationException("A capture is already pending");
+                            string id = Guid.NewGuid().ToString("N");
+                            _captureStatus = new { status = "pending", id };
+                            EventHandler<ScreenCaptureImageInfo> handler = null;
+                            handler = (_, frame) =>
+                            {
+                                lock (_captureLock)
+                                {
+                                    if (_captureHandler != handler) return;
+                                    Device.Gpu.Renderer.ScreenCaptured -= handler;
+                                    _captureHandler = null;
+                                    try
+                                    {
+                                        if (frame.Width <= 0 || frame.Height <= 0 || frame.Data.Length != checked(frame.Width * frame.Height * 4))
+                                            throw new InvalidDataException("Invalid capture size");
+                                        string dir = Path.Combine(Path.GetTempPath(), "d2r-ryujinx-" + Environment.ProcessId);
+                                        Directory.CreateDirectory(dir);
+                                        string path = Path.Combine(dir, id + ".rgba");
+                                        File.WriteAllBytes(path, frame.Data);
+                                        _captureStatus = new { status = "ready", id, path, width = frame.Width, height = frame.Height,
+                                            bgra = frame.IsBgra, flipX = frame.FlipX, flipY = frame.FlipY };
+                                    }
+                                    catch (Exception e) { _captureStatus = new { status = "error", error = e.Message }; }
+                                }
+                            };
+                            _captureHandler = handler;
+                            Device.Gpu.Renderer.ScreenCaptured += handler;
+                            Device.Gpu.Renderer.Screenshot();
+                            result = _captureStatus;
+                        }
+                        break;
+                    default: throw new ArgumentException("Invalid d2r command or argument count");
+                }
+                return JsonSerializer.Serialize(result) + "\n";
+            }
+            catch (Exception e) { return JsonSerializer.Serialize(new { error = e.Message }) + "\n"; }
+        }
+    }
+}
