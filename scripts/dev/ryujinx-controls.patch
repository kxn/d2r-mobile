--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Hid/HidDevices/NpadDevices.Script.cs
@@ -0,0 +1,51 @@
+using System;
+
+namespace Ryujinx.HLE.HOS.Services.Hid
+{
+    public partial class NpadDevices
+    {
+        private readonly object _scriptLock = new();
+        private GamepadInput? _scriptInput;
+        private long _scriptGeneration;
+        private long _scriptApplied;
+
+        public long SetScriptInput(ulong buttons, int lx, int ly, int rx, int ry)
+        {
+            foreach (int axis in new[] { lx, ly, rx, ry })
+                if (axis < -32768 || axis > 32767)
+                    throw new ArgumentOutOfRangeException(nameof(axis));
+            lock (_scriptLock)
+            {
+                var left = new JoystickPosition { Dx = lx, Dy = ly };
+                var right = new JoystickPosition { Dx = rx, Dy = ry };
+                _scriptInput = new GamepadInput
+                {
+                    PlayerId = PlayerIndex.Player1,
+                    Buttons = (ControllerKeys)buttons | _device.Hid.UpdateStickButtons(left, right),
+                    LStick = left, RStick = right,
+                };
+                return ++_scriptGeneration;
+            }
+        }
+
+        public void ClearScriptInput()
+        {
+            lock (_scriptLock) { _scriptInput = null; }
+        }
+
+        // Read back the shared-memory ring consumed by the guest, not the requested input.
+        public object GetScriptInputStatus()
+        {
+            lock (_scriptLock)
+            {
+                ref var pad = ref _device.Hid.SharedMemory.Npads[(int)PlayerIndex.Player1].InternalState;
+                ref var sample = ref pad.SystemExt.GetCurrentEntryRef();
+                return new { active = _scriptInput.HasValue, requested = _scriptGeneration,
+                    applied = _scriptApplied, style = (uint)pad.StyleSet,
+                    sample = sample.SamplingNumber, buttons = (ulong)sample.Buttons,
+                    lx = sample.AnalogStickL.X, ly = sample.AnalogStickL.Y,
+                    rx = sample.AnalogStickR.X, ry = sample.AnalogStickR.Y };
+            }
+        }
+    }
+}
