<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-libhac" value="../../.local/nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="local-libhac"><package pattern="Ryujinx.LibHac" /></packageSource>
  </packageSourceMapping>
</configuration>
