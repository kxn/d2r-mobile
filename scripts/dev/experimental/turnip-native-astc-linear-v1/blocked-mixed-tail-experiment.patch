@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: MIT
+ * Existing FDL helper rebasing counterexample; no claim to emulate hardware.
+ */
+#include "freedreno_layout.h"
+#include "fd6_hw.h"
+#include <cstdio>
+#include <cassert>
+int main()
+{
+ const struct fd_dev_id id={.chip_id=0x43030b00};
+ struct fdl_image_params p={};p.format=PIPE_FORMAT_ASTC_4x4;p.nr_samples=1;
+ p.width0=128;p.height0=128;p.depth0=1;p.mip_levels=8;p.array_size=1;p.tile_mode=TILE6_3;
+ struct fdl_layout layout;assert(fdl6_layout_image(&layout,fd_dev_info_raw(&id),&p,nullptr));
+ const struct fdl_layout *layouts[3]={&layout,nullptr,nullptr};
+ struct fdl_view_args args={};args.iova=0x100000000ull;args.base_miplevel=1;args.level_count=7;
+ args.layer_count=1;args.min_lod_clamp=1;args.format=p.format;args.type=FDL_VIEW_TYPE_2D;
+ args.swiz[0]=PIPE_SWIZZLE_X;args.swiz[1]=PIPE_SWIZZLE_Y;args.swiz[2]=PIPE_SWIZZLE_Z;args.swiz[3]=PIPE_SWIZZLE_W;
+ struct fdl6_view view;fdl6_view_init<A7XX>(&view,layouts,&args,false);
+ unsigned view_width=view.descriptor[1]&A6XX_TEX_MEMOBJ_1_WIDTH__MASK;
+ unsigned view_height=(view.descriptor[1]&A6XX_TEX_MEMOBJ_1_HEIGHT__MASK)>>A6XX_TEX_MEMOBJ_1_HEIGHT__SHIFT;
+ struct fdl_layout rebased=layout;rebased.width0=view_width;rebased.height0=view_height;
+ rebased.pitch0=view.pitch;rebased.mip_levels=args.level_count;
+ unsigned mismatches=0;
+ printf("{\"scope\":\"ACTUAL_FDL_HELPER_REBASE_COUNTEREXAMPLE_NOT_GPU_SIMULATION\",\"original_width\":128,\"baseMip\":1,\"view_width\":%u,\"view_height\":%u,\"view_PITCH\":%u,\"view_PITCHALIGN\":%u,\"view_base_address\":%llu,\"array_pitch\":%llu,\"original_mips\":[",view_width,view_height,view.pitch,view.descriptor[2]&15,(unsigned long long)view.base_addr,(unsigned long long)layout.layer_size);
+ for(unsigned m=1;m<8;++m){unsigned a=fdl_pitch(&layout,m),b=fdl_pitch(&rebased,m-1);if(a!=b)++mismatches;printf("%s{\"absolute_mip\":%u,\"physical_pitch\":%u,\"same_FDL_from_actual_view_descriptor_pitch\":%u,\"original_relative_offset\":%u}",m==1?"":",",m,a,b,layout.slices[m].offset-layout.slices[1].offset);}
+ printf("],\"rebase_mismatches\":%u,\"hardware_observed\":false}\n",mismatches);
+ /* Expected refusal: CPU helper plus one descriptor minimum is insufficient
+  * to assert an all-baseMip hardware layout contract. */
+ return mismatches?2:0;
+}
