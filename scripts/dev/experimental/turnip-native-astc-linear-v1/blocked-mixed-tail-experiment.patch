+       .slices = {{0,1024,32768},{32768,512,4608},{37376,256,1280},
+                  {38656,256,512},{39168,256,256},{39424,256,256},
+                  {39680,256,1024}} } },
+   { .format = PIPE_FORMAT_ASTC_4x4,
+     .layout = { .tile_mode = TILE6_3, .width0 = 5, .height0 = 7,
+       .slices = {{0,256,512},{512,256,256},{768,256,1024}} } },
+   { .format = PIPE_FORMAT_ASTC_6x6_SRGB,
