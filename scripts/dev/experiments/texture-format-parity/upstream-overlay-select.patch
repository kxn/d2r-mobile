+/* Diagnostic resource A/B only: resolve a cold, app-private overlay without
+ * replacing the original resource tree. Unset preserves the upstream default;
+ * an invalid explicit selection fails closed before graphics/game startup. */
+static int diagnostic_texture_overlay(char *selected, size_t capacity) {
+    const char *requested = getenv("DM_DIAG_TEXTURE_OVERLAY");
+    if (!requested) return 1;
+    if (!*requested) return 0;
+    char *private_dir = realpath(g_files, NULL);
+    char *candidate = realpath(requested, NULL);
+    char allowed[1300];
+    int n = private_dir ? snprintf(allowed, sizeof allowed, "%s/texture-format-parity/", private_dir) : -1;
+    int valid = candidate && n > 0 && (size_t)n < sizeof allowed &&
+                !strncmp(candidate, allowed, (size_t)n) && candidate[n] && strlen(candidate) < capacity;
+    if (valid) memcpy(selected, candidate, strlen(candidate) + 1);
+    free(candidate);
+    free(private_dir);
+    return valid;
 }
 
