+namespace piri {
+bool selected(const VkGraphicsPipelineCreateInfo *g,const VkComputePipelineCreateInfo *c){
+    if(!enabled || pipeline_serial>=pipeline_limit)return false;
+    if(filters.empty())return true;
+    const auto *s=g?g->pStages:&c->stage;unsigned n=g?g->stageCount:1;
+    for(unsigned i=0;i<n;i++){auto it=sources.find(s[i].module);if(it!=sources.end()&&wants_key(it->second.key))return true;}return false;
+}
+void dump(VkPipeline pipeline,const XbgPipelineKey &key,const VkGraphicsPipelineCreateInfo *g,const VkComputePipelineCreateInfo *c){
+    if(!selected(g,c))return;
+    unsigned serial=++pipeline_serial;std::string prefix="pipeline-"+std::to_string(serial);std::string meta="{\"pipeline\":"+quote(std::to_string(uint64_t(pipeline)))+",\"what\":"+quote(pstat_what())+",\"kind\":"+quote(g?"graphics":"compute")+",\"canonical_pso_key_valid\":"+(key.valid?"true":"false")+",\"canonical_pso_key_words\":[";
+    for(unsigned i=0;i<key.count;i++){if(i)meta+=',';meta+=std::to_string(key.words[i]);}meta+="],\"pipeline_flags\":"+std::to_string(g?g->flags:c->flags)+",\"stages\":[";
+    const auto *ss=g?g->pStages:&c->stage;unsigned ns=g?g->stageCount:1;
+    for(unsigned i=0;i<ns;i++){if(i)meta+=',';auto it=sources.find(ss[i].module);meta+="{\"stage\":"+std::to_string(ss[i].stage)+",\"flags\":"+std::to_string(ss[i].flags)+",\"entry\":"+quote(ss[i].pName?ss[i].pName:"")+",\"module\":"+quote(std::to_string(uint64_t(ss[i].module)));
+        if(it!=sources.end()){const auto &s=it->second;meta+=",\"key\":"+quote(s.key)+",\"spirv_file\":"+quote(s.file)+",\"spirv_bytes\":"+std::to_string(s.bytes)+",\"spirv_saved\":"+(s.saved?"true":"false");}
+        if(ss[i].pSpecializationInfo){const auto &sp=*ss[i].pSpecializationInfo;meta+=",\"specialization_present\":true,\"specialization_bytes\":"+std::to_string(sp.dataSize);if(sp.dataSize<=65536&&sp.mapEntryCount<=64){meta+=",\"specialization_data_hex\":"+quote(hex(sp.pData,sp.dataSize))+",\"specialization_map\":[";for(unsigned j=0;j<sp.mapEntryCount;j++){if(j)meta+=',';const auto &e=sp.pMapEntries[j];meta+="["+std::to_string(e.constantID)+","+std::to_string(e.offset)+","+std::to_string(e.size)+"]";}meta+=']';}else meta+=",\"specialization_oversized\":true";}
+        meta+='}';}meta+="],\"executables\":[";
+    VkPipelineInfoKHR pi{VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR};pi.pipeline=pipeline;uint32_t n=0;VkResult rc=pstat_props(cfg.device,&pi,&n,nullptr);
+    if(rc!=VK_SUCCESS || n>executable_limit){meta+="],\"properties_status\":"+std::to_string(rc)+",\"properties_count\":"+std::to_string(n)+"}\n";save_text(prefix+".json",meta);return;}
+    std::vector<VkPipelineExecutablePropertiesKHR> ex(n,VkPipelineExecutablePropertiesKHR{VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR});rc=pstat_props(cfg.device,&pi,&n,ex.data());if(rc!=VK_SUCCESS || n>ex.size()){meta+="],\"properties_status\":"+std::to_string(rc)+"}\n";save_text(prefix+".json",meta);return;}
+    for(unsigned i=0;i<n;i++){if(i)meta+=',';VkPipelineExecutableInfoKHR ei{VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR};ei.pipeline=pipeline;ei.executableIndex=i;
+        meta+="{\"index\":"+std::to_string(i)+",\"name\":"+quote(ex[i].name)+",\"description\":"+quote(ex[i].description)+",\"stages\":"+std::to_string(ex[i].stages)+",\"subgroupSize\":"+std::to_string(ex[i].subgroupSize)+",\"statistics\":[";
+        uint32_t count=0;VkResult sr=pstat_stats(cfg.device,&ei,&count,nullptr);
+        if(sr==VK_SUCCESS&&count<=256){std::vector<VkPipelineExecutableStatisticKHR> st(count,VkPipelineExecutableStatisticKHR{VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR});sr=pstat_stats(cfg.device,&ei,&count,st.data());if(sr==VK_SUCCESS&&count<=st.size())for(unsigned j=0;j<count;j++){if(j)meta+=',';auto &s=st[j];char v[80];switch(s.format){case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR:snprintf(v,sizeof v,"%u",s.value.b32);break;case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR:snprintf(v,sizeof v,"%lld",(long long)s.value.i64);break;case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR:snprintf(v,sizeof v,"%llu",(unsigned long long)s.value.u64);break;default:snprintf(v,sizeof v,"%.17g",s.value.f64);}meta+="{\"name\":"+quote(s.name)+",\"description\":"+quote(s.description)+",\"format\":"+std::to_string(s.format)+",\"value\":"+quote(v)+"}";}}
+        meta+="],\"statistics_status\":"+std::to_string(sr)+",\"internal_representations\":[";
+        VkResult irc=VK_INCOMPLETE;uint32_t ic=0;bool too_large=false;std::vector<VkPipelineExecutableInternalRepresentationKHR> ir;std::vector<std::vector<uint8_t>> data;
+        unsigned attempts=0;
+        for(;attempts<3;attempts++){
+            ic=0;irc=get_ir(cfg.device,&ei,&ic,nullptr);if(irc!=VK_SUCCESS&&irc!=VK_INCOMPLETE)break;if(ic>representation_limit){too_large=true;break;}
+            ir.assign(ic,VkPipelineExecutableInternalRepresentationKHR{VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INTERNAL_REPRESENTATION_KHR});uint32_t cap=ic;irc=get_ir(cfg.device,&ei,&ic,ir.data());if(ic>cap){irc=VK_INCOMPLETE;continue;}if(irc!=VK_SUCCESS&&irc!=VK_INCOMPLETE)break;if(irc==VK_INCOMPLETE)continue;
+            size_t total=0;too_large=false;for(unsigned j=0;j<ic;j++){if(ir[j].dataSize>file_limit||ir[j].dataSize>total_limit-written_bytes-total){too_large=true;break;}total+=ir[j].dataSize;}if(too_large)break;
+            data.clear();data.resize(ic);for(unsigned j=0;j<ic;j++){data[j].resize(ir[j].dataSize);ir[j].pData=data[j].empty()?nullptr:data[j].data();}
+            irc=get_ir(cfg.device,&ei,&ic,ir.data());if(ic>cap){irc=VK_INCOMPLETE;continue;}if(irc!=VK_INCOMPLETE)break;
+        }
+        if(irc==VK_SUCCESS&&!too_large&&ic<=ir.size()&&ic<=data.size())for(unsigned j=0;j<ic;j++){if(j)meta+=',';auto &r=ir[j];std::string name=prefix+"-exec-"+std::to_string(i)+"-ir-"+std::to_string(j)+(r.isText?".txt":".bin");bool size_ok=r.dataSize<=data[j].size();bool ok=size_ok&&save(name,data[j].data(),r.dataSize);meta+="{\"name\":"+quote(r.name)+",\"description\":"+quote(r.description)+",\"isText\":"+(r.isText?"true":"false")+",\"bytes\":"+std::to_string(r.dataSize)+",\"file\":"+quote(name)+",\"saved\":"+(ok?"true":"false")+"}";}
+        meta+="],\"internal_status\":"+std::to_string(irc)+",\"internal_count\":"+std::to_string(ic)+",\"internal_attempts\":"+std::to_string(std::min(attempts+1,3u))+",\"internal_limit_rejected\":"+(too_large?"true":"false")+"}";
+    }
+    meta+="]}\n";bool ok=save_text(prefix+".json",meta);xbg_logf("NVN PIR pipeline=%p metadata=%s saved=%d",(void*)pipeline,prefix.c_str(),int(ok));
+}
+}
