+static bool control_driver_initialize(){
+    static bool initialized=false;
+    if(initialized)return true;
+    const char *root="/data/user/0/org.kxn.d2r.upstream.profile/files/turnip-control/";
+    std::string marker=std::string(root)+"enabled";
+    if(FILE *f=fopen(marker.c_str(),"rb")){
+        fclose(f);
+        Dl_info owner{};
+        if(!dladdr(reinterpret_cast<void *>(&dm_android_vk_initialize),&owner)||!owner.dli_fname)return false;
+        std::string hooks=owner.dli_fname;hooks=hooks.substr(0,hooks.find_last_of('/'));
+        void *tools=dlopen((hooks+"/libadrenotools.so").c_str(),RTLD_NOW|RTLD_LOCAL);
+        if(!tools)return false;
+        using open_fn=void *(*)(int,int,const char *,const char *,const char *,const char *,const char *,void **);
+        auto open_driver=reinterpret_cast<open_fn>(dlsym(tools,"adrenotools_open_libvulkan"));
+        if(!open_driver)return false;
+        setenv("TU_AUTOTUNE_ALGO","prefer_sysmem",1);
+        setenv("TU_UBWC_SWAPCHAIN","1",1);
+        setenv("MESA_SHADER_CACHE_DIR",(std::string(root)+"mesa-cache").c_str(),1);
+        void *driver=open_driver(RTLD_NOW|RTLD_LOCAL,1,nullptr,hooks.c_str(),root,"libvulkan_freedreno.so",nullptr,nullptr);
+        if(!driver)return false;
+        auto proc=reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(driver,"vkGetInstanceProcAddr"));
+        if(!proc)return false;
+        volkInitializeCustom(proc);
+        __android_log_print(ANDROID_LOG_INFO,"dm-vulkan","CONTROL_DRIVER=turnip B3 prefer_sysmem UBWC1 shared0");
+    }else{
+        if(volkInitialize()!=VK_SUCCESS)return false;
+        __android_log_print(ANDROID_LOG_INFO,"dm-vulkan","CONTROL_DRIVER=system shared0");
+    }
+    initialized=true;return true;
+}
