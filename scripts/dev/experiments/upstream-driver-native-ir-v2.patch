diff --git a/dm/gfx/vulkan/engine/xbg_pipeline_internals_config.inc b/dm/gfx/vulkan/engine/xbg_pipeline_internals_config.inc
new file mode 100644
index 0000000..a4a847f
--- /dev/null
+++ b/dm/gfx/vulkan/engine/xbg_pipeline_internals_config.inc
@@ -0,0 +1,52 @@
+// Optional cold diagnostic using VK_KHR_pipeline_executable_properties only.
+// No timing/sampling. The marker is read once, before any warm worker starts.
+namespace piri {
+bool enabled=false;
+std::string directory;
+std::set<std::string> filters;
+constexpr size_t file_limit=8u*1024u*1024u,total_limit=128u*1024u*1024u;
+constexpr unsigned pipeline_limit=128,executable_limit=32,representation_limit=32;
+size_t written_bytes=0;
+unsigned module_serial=0,pipeline_serial=0;
+PFN_vkGetPipelineExecutableInternalRepresentationsKHR get_ir=nullptr;
+struct Source {std::string key,file;size_t bytes=0;bool saved=false;};
+std::map<VkShaderModule,Source> sources;
+std::string quote(const std::string &s){std::string o="\"";for(unsigned char c:s){if(c=='"'||c=='\\'){o+='\\';o+=char(c);}else if(c<32){char b[7];snprintf(b,sizeof b,"\\u%04x",unsigned(c));o+=b;}else o+=char(c);}return o+'"';}
+std::string hex(const void *p,size_t n){static const char h[]="0123456789abcdef";const auto *b=static_cast<const uint8_t*>(p);std::string o;o.reserve(n*2);for(size_t i=0;i<n;i++){o+=h[b[i]>>4];o+=h[b[i]&15];}return o;}
+bool save(const std::string &name,const void *data,size_t bytes){
+    if(bytes>file_limit || bytes>total_limit-written_bytes){xbg_logf("NVN PIR save limit file=%s bytes=%zu",name.c_str(),bytes);return false;}
+    std::string path=directory+"/"+name;
+    int fd=open(path.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_CLOEXEC|O_NOFOLLOW,0600);
+    if(fd<0){xbg_logf("NVN PIR open failed file=%s errno=%d",name.c_str(),errno);return false;}
+    FILE *f=fdopen(fd,"wb");if(!f){close(fd);return false;}
+    size_t n=bytes?fwrite(data,1,bytes,f):0;bool ok=n==bytes;int rc=fclose(f);written_bytes+=n;
+    if(!ok || rc){xbg_logf("NVN PIR write failed file=%s written=%zu expected=%zu",name.c_str(),n,bytes);return false;}return true;
+}
+bool save_text(const std::string &name,const std::string &data){return save(name,data.data(),data.size());}
+bool wants_key(const std::string &key){return filters.empty()||filters.count(key);}
+void configure(){
+    enabled=false;directory.clear();filters.clear();sources.clear();get_ir=nullptr;written_bytes=0;module_serial=0;pipeline_serial=0;
+    std::string base=cfg.shader_directory;size_t cut=base.find_last_of('/');if(cut!=std::string::npos)base.resize(cut);
+    FILE *f=fopen((base+"/gfx-pipe-internals").c_str(),"rb");if(!f)return;
+    char bytes[8193];size_t n=fread(bytes,1,sizeof bytes,f);bool bad=ferror(f)||n>8192;fclose(f);
+    if(!bad){std::string all(bytes,n);size_t p=0;while(p<all.size()){size_t a=all.find_first_not_of(" \r\n\t",p);if(a==std::string::npos)break;size_t b=all.find_first_of(" \r\n\t",a);if(b==std::string::npos)b=all.size();std::string key=all.substr(a,b-a);if(key.empty()||key.size()>64||key.find_first_not_of("0123456789abcdefABCDEF")!=std::string::npos||filters.size()>=128){bad=true;break;}for(char &c:key)if(c>='A'&&c<='F')c=char(c-'A'+'a');filters.insert(key);p=b;}}
+    if(bad){filters.clear();xbg_logf("NVN PIR invalid/oversized gfx-pipe-internals filter; disabled");return;}
+    directory=base+"/pipeline-internals-"+std::to_string(unsigned(getpid()));
+    if(mkdir(directory.c_str(),0700)){xbg_logf("NVN PIR directory refused errno=%d path=%s",errno,directory.c_str());return;}
+    get_ir=reinterpret_cast<PFN_vkGetPipelineExecutableInternalRepresentationsKHR>(vkGetDeviceProcAddr(cfg.device,"vkGetPipelineExecutableInternalRepresentationsKHR"));
+    if(!get_ir){xbg_logf("NVN PIR standard internal representation function unavailable");return;}
+    enabled=true;
+    char v[256];snprintf(v,sizeof v,"{\"vendorID\":%u,\"deviceID\":%u,\"apiVersion\":%u,\"driverVersion\":%u,\"pipelineCacheUUID\":",properties.vendorID,properties.deviceID,properties.apiVersion,properties.driverVersion);
+    std::string session=v+quote(hex(properties.pipelineCacheUUID,VK_UUID_SIZE))+",\"deviceName\":"+quote(properties.deviceName)+",\"filter_keys\":[";bool first=true;for(const auto &key:filters){if(!first)session+=',';first=false;session+=quote(key);}session+="],\"scope\":\"Static standard driver IR; not GPU timing. capture flags may force recompilation. Full pointer-free PSO schema: xbg_pipeline_key.h at upstream b811b901.\"}\n";
+    if(!save_text("session.json",session)){enabled=false;return;}
+    xbg_logf("NVN PIR enabled filters=%zu directory=%s maxPipeline=%u maxFile=%zu maxTotal=%zu",filters.size(),directory.c_str(),pipeline_limit,file_limit,total_limit);
+}
+void shader(VkShaderModule module,const std::string &key,uint32_t stage,const std::vector<uint32_t> &words){
+    if(!enabled)return;
+    if(sources.size()>=2048){xbg_logf("NVN PIR module limit reached");return;}
+    Source s;s.key=key;s.bytes=words.size()*4;s.file="module-"+std::to_string(++module_serial)+"-stage-"+std::to_string(stage)+".spv";
+    // Record exact post-rewrite bytes passed to vkCreateShaderModule, including
+    // the vertex modules of a selected fragment pipeline. No retained snapshot.
+    s.saved=save(s.file,words.data(),s.bytes);sources[module]=std::move(s);
+}
+}
