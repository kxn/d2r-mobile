--- /dev/null
+++ b/src/panfrost/vulkan/csf/panvk_kbase_diag_ring.h
@@ -0,0 +1,48 @@
+/* Diagnostic-only CS ring geometry. No queue/submission state is modified. */
+#ifndef PANVK_KBASE_DIAG_RING_H
+#define PANVK_KBASE_DIAG_RING_H
+#include <stdbool.h>
+#include <stdint.h>
+
+struct panvk_kbase_diag_segment {
+   uint64_t address;
+   uint32_t size;
+};
+
+static inline unsigned
+panvk_kbase_diag_ring_segments(uint64_t ring, uint32_t ring_size,
+                               uint64_t begin, uint64_t end,
+                               struct panvk_kbase_diag_segment out[2])
+{
+   if (!ring_size || (ring_size & (ring_size - 1)) ||
+       (ring_size & 7) || (ring & 7) || (begin & 7) || (end & 7) ||
+       ring > UINT64_MAX - ring_size || end < begin ||
+       end - begin > ring_size || end == begin)
+      return 0;
+
+   uint32_t offset = begin % ring_size;
+   uint32_t size = end - begin;
+   uint32_t first = size < ring_size - offset ? size : ring_size - offset;
+   out[0] = (struct panvk_kbase_diag_segment){ring + offset, first};
+   if (first == size)
+      return 1;
+   out[1] = (struct panvk_kbase_diag_segment){ring, size - first};
+   return 2;
+}
+
+/* A saved physical job offset names the last occurrence before insert. */
+static inline bool
+panvk_kbase_diag_tail_begin(uint64_t insert, uint32_t offset,
+                            uint32_t ring_size, uint64_t *begin)
+{
+   if (!ring_size || (ring_size & (ring_size - 1)) || offset >= ring_size)
+      return false;
+   uint32_t end_offset = insert % ring_size;
+   uint32_t size = end_offset >= offset ? end_offset - offset
+                                        : ring_size - offset + end_offset;
+   if (!size || size > insert)
+      return false;
+   *begin = insert - size;
+   return true;
+}
+#endif
