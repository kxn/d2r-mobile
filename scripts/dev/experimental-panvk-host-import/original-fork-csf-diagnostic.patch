+/* The firmware cursors are monotonic; pandecode needs bounded physical
+ * ranges. Split only the diagnostic view at wrap, never the actual ring. */
+static void
+kbase_decode_ring_range(struct panvk_gpu_queue *queue,
+                         struct panvk_subqueue *subq,
+                         uint64_t begin, uint64_t end)
+{
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+   struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   struct panvk_kbase_diag_segment segments[2];
+   unsigned count = panvk_kbase_diag_ring_segments(
+      subq->kbase.ringbuf_dev, KBASE_RINGBUF_SIZE, begin, end, segments);
+   if (!count) {
+      mesa_loge("kbase: skipping invalid diagnostic ring range %" PRIu64
+                "..%" PRIu64, begin, end);
+      return;
+   }
+   for (unsigned i = 0; i < count; i++) {
+      mesa_logi("kbase: diagnostic CS segment %u/%u gpu_va 0x%" PRIx64
+                " size %u (cursors %" PRIu64 "..%" PRIu64 ")",
+                i + 1, count, segments[i].address, segments[i].size, begin, end);
+      pandecode_cs_binary(dev->debug.decode_ctx, segments[i].address,
+                           segments[i].size, phys_dev->kmod.dev->props.gpu_id);
+   }
+}
