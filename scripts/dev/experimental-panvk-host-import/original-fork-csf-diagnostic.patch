+/* Reuse the existing static decoder for all three observed root streams.
+ * A blocked queue can depend on another queue; the first CPU waiter alone
+ * does not identify the GPU work which stopped making progress. */
+static void
+kbase_decode_timeout_streams(struct panvk_gpu_queue *queue)
+{
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+   if (!dev->debug.decode_ctx)
+      return;
+   struct {
+      uint64_t address;
+      uint32_t size;
+   } roots[PANVK_SUBQUEUE_COUNT];
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      roots[i].address = queue->subqueues[i].kbase.last_stream_addr;
+      roots[i].size = queue->subqueues[i].kbase.last_stream_size;
+   }
+   /* The last submitted root need not contain the currently stalled CALL.
+    * Decode each actually published pending ring tail as well; pandecode
+    * follows mapped CALL targets without inventing current register state.
+    * Fault-only reads, no GPU command or queue synchronization changes. */
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      struct panvk_subqueue *subq = &queue->subqueues[i];
+      if (!subq->kbase.user_io || !subq->kbase.ringbuf_cpu)
+         continue;
+      const uint8_t *input = (const uint8_t *)subq->kbase.user_io +
+                             kbase_kmod_page_size();
+      const uint8_t *output = input + kbase_kmod_page_size();
+      uint64_t end = *(volatile uint64_t *)(input + CS_USER_IO_INPUT_CS_INSERT);
+      uint64_t begin = *(volatile uint64_t *)(output + CS_USER_IO_OUTPUT_CS_EXTRACT);
+      if (begin == end)
+         continue;
+      mesa_logi("kbase: timeout pending ring subqueue %u extract %" PRIu64
+                " insert %" PRIu64 " (firmware cursor, not current PC)",
+                i, begin, end);
+      /* CS_EXTRACT can name CALL itself, whose real address/length MOVEs
+       * precede it. Include the existing retained previous complete entry
+       * only if its validated ring occurrence contains this extract. Never
+       * seed guessed registers or replace the firmware cursor/active PC. */
+      uint64_t context_begin;
+      if (panvk_kbase_diag_tail_begin(end, subq->kbase.last_last_job_offset,
+                                     KBASE_RINGBUF_SIZE, &context_begin) &&
+          context_begin <= begin) {
+         mesa_logi("kbase: pending ring subqueue %u full entry begins at %" PRIu64,
+                   i, context_begin);
+         begin = context_begin;
+      }
+      kbase_decode_ring_range(queue, subq, begin, end);
+   }
+   struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      uint64_t address = roots[i].address;
+      uint32_t size = roots[i].size;
+      if (!size || (address & 7) || (size & 7) ||
+          address > UINT64_MAX - size) {
+         mesa_loge("kbase: skipping invalid timeout root subqueue %u "
+                   "gpu_va 0x%" PRIx64 " size %u", i, address, size);
+         continue;
+      }
+      mesa_logi("kbase: timeout root subqueue %u gpu_va 0x%" PRIx64
+                " size %u (static CS listing, not current instruction)",
+                i, address, size);
+      pandecode_cs_binary(dev->debug.decode_ctx, address, size,
+                           phys_dev->kmod.dev->props.gpu_id);
+   }
+}
