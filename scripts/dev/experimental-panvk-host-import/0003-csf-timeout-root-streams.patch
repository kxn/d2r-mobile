+/* Reuse the existing static decoder for all three observed root streams.
+ * A blocked queue can depend on another queue; the first CPU waiter alone
+ * does not identify the GPU work which stopped making progress. */
+static void
+kbase_decode_timeout_streams(struct panvk_gpu_queue *queue)
+{
+   struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
+   if (!dev->debug.decode_ctx)
+      return;
+   struct {
+      uint64_t address;
+      uint32_t size;
+   } roots[PANVK_SUBQUEUE_COUNT];
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      roots[i].address = queue->subqueues[i].kbase.last_stream_addr;
+      roots[i].size = queue->subqueues[i].kbase.last_stream_size;
+   }
+   struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   for (unsigned i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      uint64_t address = roots[i].address;
+      uint32_t size = roots[i].size;
+      if (!size || (address & 7) || (size & 7) ||
+          address > UINT64_MAX - size) {
+         mesa_loge("kbase: skipping invalid timeout root subqueue %u "
+                   "gpu_va 0x%" PRIx64 " size %u", i, address, size);
+         continue;
+      }
+      mesa_logi("kbase: timeout root subqueue %u gpu_va 0x%" PRIx64
+                " size %u (static CS listing, not current instruction)",
+                i, address, size);
+      pandecode_cs_binary(dev->debug.decode_ctx, address, size,
+                           phys_dev->kmod.dev->props.gpu_id);
    }
 }
 
