+VkResult
+tu_bo_init_host_ptr(struct tu_device *dev, struct vk_object_base *base,
+                    struct tu_bo **out_bo, void *host_ptr, uint64_t size,
+                    VkMemoryPropertyFlags properties)
+{
+   *out_bo = NULL;
+   const VkMemoryPropertyFlags required = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+      VK_MEMORY_PROPERTY_HOST_CACHED_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   const VkMemoryPropertyFlags allowed = required | VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+   const uintptr_t ptr = (uintptr_t)host_ptr;
+   const uint64_t alignment = dev->physical_device->host_ptr_alignment;
+   if (!dev->instance->knl->bo_init_host_ptr ||
+       !dev->physical_device->has_host_ptr_import || !alignment)
+      return vk_error(dev, VK_ERROR_FEATURE_NOT_PRESENT);
+
+   if (!host_ptr || !size || size > UINTPTR_MAX - ptr ||
+       ptr % alignment || size % alignment ||
+       (properties & required) != required || (properties & ~allowed))
+      return vk_error(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   VkResult result = dev->instance->knl->bo_init_host_ptr(
+      dev, base, out_bo, host_ptr, size, properties);
+   if (result != VK_SUCCESS)
+      return result;
+
+   struct tu_instance *instance = dev->physical_device->instance;
+   vk_address_binding_report(&instance->vk, base ? base : &dev->vk.base,
+                             (*out_bo)->iova, (*out_bo)->size,
+                             VK_DEVICE_ADDRESS_BINDING_TYPE_BIND_EXT);
+   return VK_SUCCESS;
+}
