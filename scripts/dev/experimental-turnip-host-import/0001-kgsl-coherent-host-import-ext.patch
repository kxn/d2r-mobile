+/* This helper is shared by physical-device capability discovery and actual
+ * host-pointer imports. Success requires the final object's coherent cached
+ * mapping; ordinary allocation support is not a substitute for this check.
+ */
+static int
+kgsl_import_host_pages(int fd, void *host_ptr, uint64_t size,
+                        struct kgsl_gpuobj_info *info)
+{
+   struct kgsl_gpuobj_import_useraddr addr = {
+      .virtaddr = (uintptr_t)host_ptr,
+   };
+   const uint64_t required_flags = KGSL_MEMFLAGS_IOCOHERENT |
+      ((uint64_t)KGSL_CACHEMODE_WRITEBACK << KGSL_CACHEMODE_SHIFT);
+   struct kgsl_gpuobj_import req = {
+      .priv = (uintptr_t)&addr,
+      /* For ADDR this is the imported memory extent, not sizeof(addr). */
+      .priv_len = size,
+      .flags = required_flags,
+      .type = KGSL_USER_MEM_TYPE_ADDR,
+   };
+   if (safe_ioctl(fd, IOCTL_KGSL_GPUOBJ_IMPORT, &req))
+      return -1;
+
+   *info = (struct kgsl_gpuobj_info) { .id = req.id };
+   if (safe_ioctl(fd, IOCTL_KGSL_GPUOBJ_INFO, info))
+      goto fail;
+
