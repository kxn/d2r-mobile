+       (info->flags & (KGSL_MEMFLAGS_IOCOHERENT | KGSL_CACHEMODE_MASK)) != required_flags ||
+       info->size != size || !info->gpuaddr || info->gpuaddr > UINT64_MAX - size ||
+       (info->flags & (KGSL_MEMFLAGS_USE_CPU_MAP | KGSL_MEMFLAGS_GPUREADONLY |
