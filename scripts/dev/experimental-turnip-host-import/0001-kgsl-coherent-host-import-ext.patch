+      const int error = errno;
+      struct kgsl_gpumem_free_id free_req = { .id = req.id };
+      if (safe_ioctl(fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req))
+         mesa_logw("KGSL failed to release rejected host import: %s", strerror(errno));
+      errno = error;
+   }
+   return -1;
+}
+
+static bool
+kgsl_probe_host_import(int fd, size_t size)
+{
+   void *map = mmap(NULL, size, PROT_READ | PROT_WRITE,
+                    MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+   if (map == MAP_FAILED)
+      return false;
+   memset(map, 0xa5, size);
+
+   struct kgsl_gpuobj_info info;
+   bool supported = kgsl_import_host_pages(fd, map, size, &info) == 0;
+   if (supported) {
+      struct kgsl_gpumem_free_id free_req = { .id = info.id };
+      supported = safe_ioctl(fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req) == 0;
+      if (!supported)
+         mesa_logw("KGSL failed to release host-import probe: %s", strerror(errno));
+   }
+   if (munmap(map, size))
+      supported = false;
+   return supported;
+}
+
+static VkResult
+kgsl_bo_init_host_ptr(struct tu_device *dev, struct vk_object_base *base,
+                      struct tu_bo **out_bo, void *host_ptr, uint64_t size,
+                      VkMemoryPropertyFlags properties)
+{
+   struct kgsl_gpuobj_info info;
+   if (kgsl_import_host_pages(dev->physical_device->local_fd, host_ptr, size, &info))
+      return vk_errorf(dev, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "KGSL host pointer import rejected (%s)", strerror(errno));
+
+   struct tu_bo *bo = tu_device_lookup_bo(dev, info.id);
+   if (!bo) {
+      struct kgsl_gpumem_free_id free_req = { .id = info.id };
+      safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUMEM_FREE_ID, &free_req);
+      return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   assert(bo->gem_handle == 0);
+   *bo = (struct tu_bo) {
+      .gem_handle = info.id,
+      .size = size,
+      .iova = info.gpuaddr,
+      .map = host_ptr,
+      .name = tu_debug_bos_add(dev, size, "imported host pages"),
+      .refcnt = 1,
+      .shared_fd = -1,
+      .never_unmap = true,
+      .imported_host_ptr = true,
+      .base = base,
+      .unique_id = info.id,
+   };
+   tu_dump_bo_init(dev, bo);
+   TU_RMV(bo_allocate, dev, bo);
+   TU_RMV(bo_map, dev, bo);
+   *out_bo = bo;
+   return VK_SUCCESS;
+}
