+static uint32_t
+tu_host_ptr_memory_types(const struct tu_physical_device *pdevice)
+{
+   if (!pdevice->has_host_ptr_import)
+      return 0;
+   const VkMemoryPropertyFlags required = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+      VK_MEMORY_PROPERTY_HOST_CACHED_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   const VkMemoryPropertyFlags allowed = required | VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+   uint32_t types = 0;
+   for (uint32_t i = 0; i < pdevice->memory.non_lazy_type_count; i++) {
+      const VkMemoryPropertyFlags props = pdevice->memory.types[i];
+      if ((props & required) == required && !(props & ~allowed))
+         types |= 1u << i;
+   }
+   return types;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetMemoryHostPointerPropertiesEXT(VkDevice _device,
+                                       VkExternalMemoryHandleTypeFlagBits handle_type,
+                                       const void *host_ptr,
+                                       VkMemoryHostPointerPropertiesEXT *properties)
+{
+   VK_FROM_HANDLE(tu_device, device, _device);
+   properties->memoryTypeBits = 0;
+   if (!device->vk.enabled_extensions.EXT_external_memory_host ||
+       handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       !host_ptr || !device->physical_device->host_ptr_alignment ||
+       (uintptr_t)host_ptr % device->physical_device->host_ptr_alignment)
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   properties->memoryTypeBits = tu_host_ptr_memory_types(device->physical_device);
+   return properties->memoryTypeBits ? VK_SUCCESS :
+      vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+}
+
+static VkResult
+tu_import_host_memory(struct tu_device *device,
+                       const VkMemoryAllocateInfo *info,
+                       const VkImportMemoryHostPointerInfoEXT *host_info,
+                       const VkAllocationCallbacks *allocator,
+                       VkDeviceMemory *out_memory)
+{
+   *out_memory = VK_NULL_HANDLE;
+   if (!device->vk.enabled_extensions.EXT_external_memory_host ||
+       host_info->handleType != VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT ||
+       !info->allocationSize || info->memoryTypeIndex >= VK_MAX_MEMORY_TYPES ||
+       !(tu_host_ptr_memory_types(device->physical_device) & (1u << info->memoryTypeIndex)))
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   const VkExportMemoryAllocateInfo *export_info =
+      vk_find_struct_const(info->pNext, EXPORT_MEMORY_ALLOCATE_INFO);
+   const VkImportMemoryFdInfoKHR *fd_info =
+      vk_find_struct_const(info->pNext, IMPORT_MEMORY_FD_INFO_KHR);
+   const VkMemoryAllocateFlagsInfo *flags_info =
+      vk_find_struct_const(info->pNext, MEMORY_ALLOCATE_FLAGS_INFO);
+   const VkMemoryOpaqueCaptureAddressAllocateInfo *replay_info =
+      vk_find_struct_const(info->pNext, MEMORY_OPAQUE_CAPTURE_ADDRESS_ALLOCATE_INFO);
+   const VkMemoryDedicatedAllocateInfo *dedicated =
+      vk_find_struct_const(info->pNext, MEMORY_DEDICATED_ALLOCATE_INFO);
+   if ((export_info && export_info->handleTypes) ||
+       (fd_info && fd_info->handleType) ||
+       vk_find_struct_const(info->pNext, IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID) ||
+       (flags_info && (flags_info->flags & ~VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT)) ||
+       (replay_info && replay_info->opaqueCaptureAddress) ||
+       (dedicated && dedicated->image))
+      return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   if (dedicated && dedicated->buffer) {
+      VK_FROM_HANDLE(tu_buffer, buffer, dedicated->buffer);
+      if (!buffer->host_external || buffer->vk.create_flags)
+         return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+   }
+
+   const uint64_t used = p_atomic_read(&device->physical_device->heap.used);
+   const uint64_t capacity = device->physical_device->heap.size;
+   if (used > capacity || info->allocationSize > capacity - used) {
+      tu_memory_emit_report(device, NULL, info, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return vk_error(device, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   }
+
+   struct tu_device_memory *mem = (struct tu_device_memory *)
+      vk_device_memory_create(&device->vk, info, allocator, sizeof(*mem));
+   if (!mem) {
+      tu_memory_emit_report(device, NULL, info, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   mem->size = info->allocationSize;
+   mem->refcnt = 1;
+   VkResult result = tu_bo_init_host_ptr(device, &mem->vk.base, &mem->bo,
+      host_info->pHostPointer, info->allocationSize,
+      device->physical_device->memory.types[info->memoryTypeIndex]);
+   if (result == VK_SUCCESS) {
+      /* tu_add_to_heap releases the BO on failure. Never publish or dereference
+       * that released BO, and never subtract heap bytes that were not added.
+       */
+      result = tu_add_to_heap(device, mem->bo);
+      if (result == VK_SUCCESS)
+         mem->iova = mem->bo->iova;
+      else
+         mem->bo = NULL;
+   }
+   if (result != VK_SUCCESS) {
+      vk_device_memory_destroy(&device->vk, allocator, &mem->vk);
+      tu_memory_emit_report(device, NULL, info, result);
+      return result;
+   }
+
+   TU_RMV(heap_create, device, info, mem);
+   tu_memory_emit_report(device, mem, info, VK_SUCCESS);
+   *out_memory = tu_device_memory_to_handle(mem);
+   return VK_SUCCESS;
+}
