diff --git a/src/panfrost/vulkan/panvk_dm_native_image.h b/src/panfrost/vulkan/panvk_dm_native_image.h
new file mode 100644
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_dm_native_image.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: MIT
+ * DM native image producer v1: opt-in platform contract, not a portable
+ * interpretation of optimal-tiling VkSubresourceLayout fields.
+ */
+#ifndef PANVK_DM_NATIVE_IMAGE_H
+#define PANVK_DM_NATIVE_IMAGE_H
+
+#include "vk_util.h"
+
+static inline bool
+panvk_dm_native_image_recipe(bool enabled, VkImageType type, VkFormat format,
+                             VkImageTiling tiling, VkImageUsageFlags usage,
+                             VkImageCreateFlags flags)
+{
+   return enabled && type == VK_IMAGE_TYPE_2D &&
+          (format == VK_FORMAT_ASTC_4x4_UNORM_BLOCK ||
+           format == VK_FORMAT_ASTC_4x4_SRGB_BLOCK ||
+           format == VK_FORMAT_ASTC_6x6_UNORM_BLOCK ||
+           format == VK_FORMAT_ASTC_6x6_SRGB_BLOCK) &&
+          tiling == VK_IMAGE_TILING_OPTIMAL && flags == 0 &&
+          usage == (VK_IMAGE_USAGE_SAMPLED_BIT |
+                    VK_IMAGE_USAGE_HOST_TRANSFER_BIT_EXT);
+}
+
+static inline bool
+panvk_dm_native_image_create(bool enabled, const VkImageCreateInfo *info)
+{
+   if (!panvk_dm_native_image_recipe(enabled, info->imageType, info->format,
+                                      info->tiling, info->usage, info->flags) ||
+       info->arrayLayers != 1 || info->extent.depth != 1 ||
+       !info->extent.width || !info->extent.height || !info->mipLevels ||
+       info->samples != VK_SAMPLE_COUNT_1_BIT ||
+       info->initialLayout != VK_IMAGE_LAYOUT_UNDEFINED)
+      return false;
+   unsigned host_structs = 0;
+   vk_foreach_struct_const(sType, ext, info->pNext) {
+      if (sType != VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO)
+         continue;
+      const VkExternalMemoryImageCreateInfo *external = (const void *)ext;
+      if (external->handleTypes !=
+          VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT)
+         return false;
+      host_structs++;
+   }
+   return host_structs == 1;
+}
+
+#endif
