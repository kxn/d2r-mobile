+/* Optional pipeline identity metadata. Never a per-dispatch capture or timer.
+ * Cached binaries still get an upload identity, without inventing a NIR name. */
+static void
+panvk_debug_compute_shader_map(const struct panvk_shader_variant *shader,
+                                const char *phase, const char *nir_name,
+                                uint64_t spd)
+{
+   if (!PANVK_DEBUG(SHADER_MAP) ||
+       shader->info.stage != MESA_SHADER_COMPUTE ||
+       !shader->bin_ptr || !shader->bin_size)
+      return;
+
+   blake3_hash hash;
+   char hex[BLAKE3_HEX_LEN];
+   _mesa_blake3_compute(shader->bin_ptr, shader->bin_size, hash);
+   _mesa_blake3_format(hex, hash);
+   mesa_logi("compute_shader_map: phase=%s binary_blake3=%s bytes=%u "
+              "local=%ux%ux%u spd=0x%llx nir_name=%.160s",
+              phase, hex, shader->bin_size,
+              shader->cs.local_size.x, shader->cs.local_size.y,
+              shader->cs.local_size.z, (unsigned long long)spd,
+              nir_name ? nir_name : "<unknown/cache-or-upload>");
+}
+
 static VkResult
 panvk_compile_nir(struct panvk_device *dev, nir_shader *nir,
                   VkShaderCreateFlagsEXT shader_flags,
@@ -1369,6 +1393,7 @@ panvk_compile_nir(struct panvk_device *dev, nir_shader *nir,
       break;
    }
 
+   panvk_debug_compute_shader_map(shader, "compile", nir->info.name, 0);
    return VK_SUCCESS;
 }
 
@@ -1537,6 +1562,10 @@ panvk_shader_upload(struct panvk_device *dev,
    }
 #endif
 
+#if PAN_ARCH >= 9
+   panvk_debug_compute_shader_map(shader, "upload", NULL,
+                                  panvk_priv_mem_dev_addr(shader->spd));
+#endif
    return VK_SUCCESS;
 }
 
