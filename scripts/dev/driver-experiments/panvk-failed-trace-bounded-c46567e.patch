+/* Preserve the original address across RUN as the eligibility token: the
+ * original tracer already requires that register to survive RUN. No extra
+ * persistent register or duplicated RUN instruction is needed. */
+static inline void
+cs_trace_preamble(struct cs_builder *b, const struct cs_tracing_ctx *ctx,
+                  struct cs_index scratch_regs, unsigned trace_size)
+{
+   if (!ctx->bounded) {
+      cs_trace_preamble_unbounded(b, ctx, scratch_regs, trace_size);
+      return;
+   }
+
+   struct cs_index remaining = cs_reg32(b, scratch_regs.reg + 2);
+   struct cs_index addr = cs_reg64(b, scratch_regs.reg);
+   cs_load32_to(b, remaining, ctx->ctx_reg, ctx->remaining_offset);
+   cs_add_imm32(b, remaining, remaining, -(int32_t)trace_size);
+   cs_if(b, MALI_CS_CONDITION_GEQUAL, remaining) {
+      cs_store32(b, remaining, ctx->ctx_reg, ctx->remaining_offset);
+      cs_trace_preamble_unbounded(b, ctx, scratch_regs, trace_size);
+   }
+   cs_else(b) {
+      cs_move32_to(b, remaining, 0);
+      cs_store32(b, remaining, ctx->ctx_reg, ctx->remaining_offset);
+      cs_move64_to(b, addr, 0);
+      cs_flush_stores(b);
+   }
+}
