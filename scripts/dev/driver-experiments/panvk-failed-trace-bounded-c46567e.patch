index 36eea4c..d1994bf 100644
--- a/src/panfrost/genxml/decode_common.c
+++ b/src/panfrost/genxml/decode_common.c
@@ -64,6 +64,24 @@ pandecode_find_mapped_gpu_mem_containing_rw(struct pandecode_context *ctx,
    return to_mapped_memory(node);
 }
 
+const void *
+pandecode_fetch_gpu_mem_checked(struct pandecode_context *ctx,
+                                uint64_t addr, size_t size)
+{
+   simple_mtx_assert_locked(&ctx->lock);
+   struct rb_node *node =
+      rb_tree_search(&ctx->mmap_tree, &addr, pandecode_cmp_key);
+   if (!node)
+      return NULL;
+
+   const struct pandecode_mapped_memory *mem = to_mapped_memory(node);
+   uint64_t offset = addr - mem->gpu_va;
+   if (!mem->addr || offset > mem->length || size > mem->length - offset)
+      return NULL;
+
+   return (const uint8_t *)mem->addr + offset;
+}
+
 struct pandecode_mapped_memory *
 pandecode_find_mapped_gpu_mem_containing(struct pandecode_context *ctx,
                                          uint64_t addr)
@@ -490,6 +508,33 @@ pandecode_cs_trace(struct pandecode_context *ctx, uint64_t trace_gpu_va,
    simple_mtx_unlock(&ctx->lock);
 }
 
+void
+pandecode_cs_trace_partial(struct pandecode_context *ctx, uint64_t trace_gpu_va,
+                   uint32_t size, uint64_t gpu_id)
+{
+   simple_mtx_lock(&ctx->lock);
+
+   switch (pan_arch(gpu_id)) {
+   case 10:
+   case 11:
+      pandecode_cs_trace_partial_v10(ctx, trace_gpu_va, size, gpu_id);
+      break;
+   case 12:
+      pandecode_cs_trace_partial_v12(ctx, trace_gpu_va, size, gpu_id);
+      break;
+   case 13:
+      pandecode_cs_trace_partial_v13(ctx, trace_gpu_va, size, gpu_id);
+      break;
+   case 14:
+      pandecode_cs_trace_partial_v14(ctx, trace_gpu_va, size, gpu_id);
+      break;
+   default:
+      UNREACHABLE("Unsupported architecture");
+   }
+
+   simple_mtx_unlock(&ctx->lock);
+}
+
 void
 pandecode_set_disassemble(struct pandecode_context *ctx,
                           pandecode_shader_disassemble_cb cb)
