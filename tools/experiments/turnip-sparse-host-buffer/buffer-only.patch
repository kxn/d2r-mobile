--- a/src/freedreno/vulkan/tu_buffer.cc
+++ b/src/freedreno/vulkan/tu_buffer.cc
@@ -16,0 +17,19 @@
+
+// Isolated Buffer-only host/sparse experiment. These are software eligibility
+// checks, not proof that the kernel accepts an imported host BO as a VBO child.
+// Keep the existing KGSL probes/features unchanged; the GPU oracle must verify
+// the combination before any application uses this experimental driver.
+bool
+tu_host_buffer_flags_supported(const struct tu_physical_device *pdevice,
+                               VkBufferCreateFlags flags)
+{
+   if (!pdevice->has_host_ptr_import)
+      return false;
+   if (!flags)
+      return true;
+   const VkBufferCreateFlags allowed = VK_BUFFER_CREATE_SPARSE_BINDING_BIT |
+      VK_BUFFER_CREATE_SPARSE_RESIDENCY_BIT;
+   return !(flags & ~allowed) &&
+      (flags & VK_BUFFER_CREATE_SPARSE_BINDING_BIT) && pdevice->has_sparse &&
+      (!(flags & VK_BUFFER_CREATE_SPARSE_RESIDENCY_BIT) || pdevice->has_sparse_prr);
+}
