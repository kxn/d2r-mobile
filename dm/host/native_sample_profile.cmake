# Optional sample-PGO for host C/C++ only. No runtime instrumentation.
include_guard(GLOBAL)
set(DM_NATIVE_SAMPLE_PROFILE "" CACHE FILEPATH "Explicit LLVM sample profile (default disabled)")
set(DM_NATIVE_SAMPLE_PROFILE_SHA256 "" CACHE STRING "Expected SHA256 of explicit sample profile")
if(DM_NATIVE_SAMPLE_PROFILE STREQUAL "")
  if(NOT DM_NATIVE_SAMPLE_PROFILE_SHA256 STREQUAL "")
    message(FATAL_ERROR "Sample profile path/hash must be provided together")
  endif()
else()
  if(NOT DM_NATIVE_SAMPLE_PROFILE_SHA256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Sample profile requires its exact lowercase SHA256")
  endif()
  string(LENGTH "${DM_NATIVE_SAMPLE_PROFILE_SHA256}" profile_hash_length)
  if(NOT profile_hash_length EQUAL 64 OR NOT EXISTS "${DM_NATIVE_SAMPLE_PROFILE}")
    message(FATAL_ERROR "Sample profile input is missing or hash is invalid")
  endif()
  if(DM_NATIVE_THINLTO)
    message(FATAL_ERROR "Sample profile and ThinLTO are separate compiler experiments")
  endif()
  if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "Sample profile requires Clang C/C++")
  endif()
  file(SHA256 "${DM_NATIVE_SAMPLE_PROFILE}" actual_profile_hash)
  if(NOT actual_profile_hash STREQUAL DM_NATIVE_SAMPLE_PROFILE_SHA256)
    message(FATAL_ERROR "Sample profile input SHA256 differs")
  endif()
  # Configure-time input dependency plus content-addressed private copy: a
  # changed profile cannot silently reuse a previous object/compile command.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DM_NATIVE_SAMPLE_PROFILE}")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/sample-profile")
  set(DM_NATIVE_SAMPLE_PROFILE_FROZEN "${CMAKE_CURRENT_BINARY_DIR}/sample-profile/${actual_profile_hash}.prof")
  configure_file("${DM_NATIVE_SAMPLE_PROFILE}" "${DM_NATIVE_SAMPLE_PROFILE_FROZEN}" COPYONLY)
endif()
function(dm_native_sample_profile target)
  if(DM_NATIVE_SAMPLE_PROFILE STREQUAL "")
    return()
  endif()
  foreach(flag "-fprofile-sample-use=${DM_NATIVE_SAMPLE_PROFILE_FROZEN}"
      -Rpass-analysis=sample-profile.* -Rpass=sample-profile.*
      -fsave-optimization-record -foptimization-record-passes=sample-profile.*)
    target_compile_options(${target} PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:${flag}>")
  endforeach()
endfunction()
