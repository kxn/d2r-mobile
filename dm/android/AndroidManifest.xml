<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.d2rmobile.nativeport" android:versionCode="1" android:versionName="0.1">
  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
  <!-- Injected GPU tools use sockets to communicate with their profiling service. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
  <!-- 调试层由独立工具 APK 提供；Android 包可见性过滤不能隐藏它们。
       Debug layers come from separate tool APKs; Android package visibility must expose these providers. -->
  <queries>
    <package android:name="com.arm.frameadvisor.replay" />
    <package android:name="org.renderdoc.renderdoccmd.arm64" />
    <package android:name="com.qualcomm.snapdragonprofiler.profilerlayer.arm64_v8a" />
  </queries>
  <application android:label="@string/app_name" android:appCategory="game" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" android:debuggable="true" android:extractNativeLibs="true" android:allowBackup="false">
    <meta-data android:name="com.android.graphics.injectLayers.enable" android:value="true" />
    <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
    <activity android:name=".MainActivity" android:launchMode="singleTop" android:exported="true" android:screenOrientation="landscape" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
  </application>
</manifest>
