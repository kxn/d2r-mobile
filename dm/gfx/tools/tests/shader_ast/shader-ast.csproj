    <Compile Include="../../../../third_party/ryujinx/src/Ryujinx.Graphics.Shader/**/*.cs"
             Exclude="../../../../third_party/ryujinx/src/Ryujinx.Graphics.Shader/**/obj/**;../../../../third_party/ryujinx/src/Ryujinx.Graphics.Shader/**/bin/**" />
    <ProjectReference Include="../../../../third_party/ryujinx/src/Ryujinx.Common/Ryujinx.Common.csproj" />
    <ProjectReference Include="../../../../third_party/ryujinx/src/Spv.Generator/Spv.Generator.csproj" />
  </ItemGroup>
</Project>
