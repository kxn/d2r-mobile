#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std140) uniform Parameters {uvec4 p;} u;
layout(set=0,binding=1,std430) buffer Output {uint value;} o;
layout(set=0,binding=2) uniform usamplerBuffer texels;
layout(set=0,binding=3) uniform usampler2D image;
void main(){o.value=u.p.x+texelFetch(texels,0).x+texelFetch(image,ivec2(0),0).x;}
