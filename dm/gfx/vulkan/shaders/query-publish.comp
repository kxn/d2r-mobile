#version 450
// Original NVN report ABI: two little-endian 64-bit words, using only u32.
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Results { uint input_words[]; };
layout(set=0,binding=1,std430) writeonly buffer Report { uint output_words[]; };
layout(push_constant) uniform Parameters {
    uint multiplier;
    int binary_shift;
    uint valid_bits;
    uint sample_count;
    uint destination_word;
    uint samples_report;
} p;
uvec2 add_pair(uvec2 a,uvec2 b) {
    uint carry;uint lo=uaddCarry(a.x,b.x,carry);
    return uvec2(lo,a.y+b.y+carry);
}
uint product_digit(uvec3 product,int first) {
    // The numerator is a 96-bit product followed by binary_shift zero bits.
    // Read one radix-65536 digit, including a partially shifted low digit.
    if(first<0)return first>-16?(product.x<<uint(-first))&65535u:0u;
    uint word=uint(first)/32u,bit=uint(first)%32u;
    uint value=product[word]>>bit;
    if(bit>16u && word<2u)value|=product[word+1u]<<(32u-bit);
    return value&65535u;
}
uvec2 scaled_ticks(uvec2 raw) {
    if(p.valid_bits<32u)raw=uvec2(raw.x&((1u<<p.valid_bits)-1u),0u);
    else if(p.valid_bits==32u)raw.y=0u;
    else if(p.valid_bits<64u)raw.y&=(1u<<(p.valid_bits-32u))-1u;
    uint h0,l0,h1,l1,carry;
    umulExtended(raw.x,p.multiplier,h0,l0);
    umulExtended(raw.y,p.multiplier,h1,l1);
    uint middle=uaddCarry(h0,l1,carry);
    uvec3 product=uvec3(l0,middle,h1+carry);
    // Exact long division in radix 65536 instead of one bit at a time.
    // remainder<625, so remainder*65536+digit is <40960000: every division
    // fits u32, with a constant divisor the compiler can strength-reduce.
    // Negative shifts are applied to quotient digits, preserving exact floor.
    int positive=max(p.binary_shift,0),negative=max(-p.binary_shift,0);
    uint remainder=0u;uvec2 result=uvec2(0u);bool overflow=false;
    for(int chunk=(95+positive)/16;chunk>=0;--chunk) {
        uint numerator=(remainder<<16)|product_digit(product,chunk*16-positive);
        uint digit=numerator/625u;remainder=numerator%625u;
        int target=chunk*16-negative;
        if(target<0) {
            if(target>-16)result.x|=digit>>uint(-target);
        } else if(target<32) {
            result.x|=digit<<uint(target);
            if(target>16)result.y|=digit>>uint(32-target);
        } else if(target<64) {
            result.y|=digit<<uint(target-32);
            if(target>48 && (digit>>uint(64-target))!=0u)overflow=true;
        } else if(digit!=0u)overflow=true;
    }
    return overflow?uvec2(0xffffffffu):result;
}
void main() {
    uvec2 ticks=scaled_ticks(uvec2(input_words[0],input_words[1]));
    uvec2 sum=uvec2(0u);
    for(uint i=0u;i<p.sample_count;i++)
        sum=add_pair(sum,uvec2(input_words[2u+2u*i],input_words[3u+2u*i]));
    uvec2 value=p.samples_report!=0u?sum:ticks;
    uint at=p.destination_word;
    output_words[at]=value.x;output_words[at+1u]=value.y;
    output_words[at+2u]=ticks.x;output_words[at+3u]=ticks.y;
}
