#version 450
// NVN event payload arithmetic is uint32 modulo 2^32. One invocation touches
// exactly the selected word; the descriptor prefix is alignment only.
layout(local_size_x=1, local_size_y=1, local_size_z=1) in;
layout(set=0,binding=0,std430) buffer EventWords { uint words[]; } event_buffer;
layout(push_constant) uniform EventAdd { uint word; uint value; } event_add;
void main() { atomicAdd(event_buffer.words[event_add.word],event_add.value); }
